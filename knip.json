{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"tags": ["-lintignore"],
	"workspaces": {
		".": {},
		"apps/website": {
			"entry": ["src/router.tsx", "src/routes/**/*.{ts,tsx}"],
			"project": ["src/**/*.{ts,tsx}"]
		},
		"apps/portal": {
			"entry": [
				"src/router.tsx",
				"src/routes/**/*.{ts,tsx}",
				"src/styles.css",
				"workbox-config.js"
			],
			"project": ["src/**/*.{ts,tsx}"]
		},
		"apps/internal": {
			"entry": ["src/router.tsx", "src/routes/**/*.{ts,tsx}", "src/styles.css"],
			"project": ["src/**/*.{ts,tsx}"],
			"ignore": ["src/shims/*.ts"]
		},
		"apps/driver": {
			"entry": ["src/router.tsx", "src/styles.css"],
			"project": ["src/**/*.{ts,tsx}"]
		}
	},
	"ignoreBinaries": [
		"infisical",
		"gitleaks",
		"osv-scanner",
		"semgrep",
		"supabase",
		"jq"
	],
	"ignoreDependencies": [
		"@capacitor/ios",
		"@ast-grep/cli",
		"rollup-plugin-visualizer",
		"tailwindcss",
		"tailwindcss-react-aria-components"
	],
	"ignoreIssues": {
		"packages/types/src/database.types.ts": ["exports", "types"]
	}
}
