{
	"$schema": "https://unpkg.com/knip@6/schema.json",
	"tags": ["-lintignore"],
	"workspaces": {
		".": {},
		"apps/website": {
			"entry": ["src/router.tsx", "src/routes/**/*.{ts,tsx}"],
			"project": ["src/**/*.{ts,tsx}"]
		},
		"apps/portal": {
			"entry": [
				"vite.config.ts",
				"vitest.config.ts",
				"src/router.tsx",
				"src/routes/**/*.{ts,tsx}",
				"src/styles.css",
				"workbox-config.js"
			],
			"project": ["vite.config.ts", "vitest.config.ts", "src/**/*.{ts,tsx,css}"]
		},
		"apps/internal": {
			"entry": [
				"vite.config.ts",
				"vitest.config.ts",
				"src/router.tsx",
				"src/routes/**/*.{ts,tsx}",
				"src/styles.css"
			],
			"project": [
				"vite.config.ts",
				"vitest.config.ts",
				"src/**/*.{ts,tsx,css}"
			],
			"ignore": ["src/shims/*.ts"]
		}
	},
	"ignoreBinaries": ["infisical", "gitleaks", "supabase", "jq"],
	"ignoreDependencies": ["cloudflare"]
}
