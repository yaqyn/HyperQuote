# apps/portal — customer-facing account, orders, quotes
# Copy to `.env` and fill in. `.env` is gitignored.

# ─── Supabase client (browser) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Supabase server (Cloudflare Secrets Store in production) ───────────
# Local dev may use `.env`; production binds these from Cloudflare Secrets Store.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth session cookie scope ─────────────────────────────
# Production website + portal should share this customer cookie on hyperquote.net.
SUPABASE_COOKIE_NAME=hyperquote_customer_auth
COOKIE_DOMAIN=.hyperquote.net

# ─── Cross-app URLs ────────────────────────────────────────
VITE_INTERNAL_URL=https://internal.hyperquote.net

# ─── Maps — delivery route rendering ───────────────────────
VITE_MAPTILER_KEY=your-maptiler-key
# Optional. Defaults to the public OSRM route endpoint when unset.
VITE_ROAD_ROUTE_ENDPOINT=https://router.project-osrm.org/route/v1/driving

# ─── AI chat (server only; do not prefix with VITE_) ────────
# Local dev: set GROQ_API_KEY in .env or inject it from your operator vault.
# Production: bind this from Cloudflare Secrets Store.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
USE_AI=1
# For Qwen only:
# GROQ_REASONING_EFFORT=none
# GROQ_URL=https://api.groq.com/openai/v1/chat/completions
