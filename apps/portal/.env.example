# apps/portal — customer-facing account, orders, quotes
# Copy to `.env` and fill in. `.env` is gitignored.

# ─── Supabase client (browser) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Supabase server (Cloudflare Worker secrets) ───────────
# Set via `wrangler secret put <name>` in production.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth session cookie scope ─────────────────────────────
# Use the apex domain (with leading dot) so sessions survive the
# portal ↔ website ↔ internal boundary.
COOKIE_DOMAIN=.hyperquote.net

# ─── Cross-app URLs ────────────────────────────────────────
VITE_WEBSITE_URL=https://hyperquote.net
