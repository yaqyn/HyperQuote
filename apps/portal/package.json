{
	"name": "@hyperquote/portal",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "NODE_OPTIONS=--max-http-header-size=32768 node ../../scripts/with-dev-secrets.mjs vite dev --port 3001",
		"build": "vite build",
		"build:worker": "node ../../scripts/build-worker.mjs portal",
		"cf-typegen": "wrangler types",
		"deploy:worker": "bun run build:worker && wrangler deploy",
		"routes:generate": "tsr generate",
		"typecheck": "bun run routes:generate && tsc --noEmit",
		"preview": "vite preview",
		"test": "vitest run"
	},
	"dependencies": {
		"@hyperquote/ai": "workspace:*",
		"@hyperquote/auth": "workspace:*",
		"@hyperquote/docs": "workspace:*",
		"@hyperquote/forms": "workspace:*",
		"@hyperquote/i18n": "workspace:*",
		"@hyperquote/quote-cart": "workspace:*",
		"@hyperquote/runtime": "workspace:*",
		"@hyperquote/ui": "workspace:*",
		"@internationalized/date": "^3.12.1",
		"@tanstack/ai": "^0.9.2",
		"@tanstack/ai-react": "0.7.8",
		"@tanstack/react-hotkeys": "^0.9.1",
		"@tanstack/react-query": "^5.100.10",
		"@tanstack/react-router": "^1.170.8",
		"@tanstack/react-start": "^1.168.13",
		"fuse.js": "^7.1.0",
		"i18next": "^26.2.0",
		"lucide-react": "^1.16.0",
		"maplibre-gl": "^5.24.0",
		"motion": "^12.38.0",
		"papaparse": "^5.5.3",
		"qrcode": "^1.5.4",
		"react": "^19.2.6",
		"react-aria-components": "^1.17.0",
		"react-dom": "^19.2.6",
		"react-hook-form": "^7.76.0",
		"react-i18next": "^17.0.8",
		"react-map-gl": "^8.1.1",
		"recharts": "^3.8.1",
		"zod": "^4.4.3",
		"zustand": "^5.0.13"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/router-cli": "1.167.10",
		"@types/node": "^25.9.1",
		"@types/papaparse": "^5.5.2",
		"@types/qrcode": "^1.5.6",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "~5.2.0",
		"nitro": "^3.0.260522-beta",
		"tailwindcss": "^4.3.0",
		"tailwindcss-react-aria-components": "^2.1.0",
		"typescript": "^6.0.3",
		"vite": "~7.3.3",
		"vitest": "^4.1.6",
		"workbox-build": "^7.4.1"
	}
}
