{
	"name": "@hyperquote/website",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "NODE_OPTIONS='--max-http-header-size=32768 --no-experimental-webstorage' node ../../scripts/with-dev-secrets.mjs vite dev --port 3000",
		"build": "vite build",
		"build:worker": "node ../../scripts/build-worker.mjs website",
		"cf-typegen": "wrangler types",
		"deploy:worker": "bun run build:worker && wrangler deploy",
		"routes:generate": "tsr generate",
		"typecheck": "bun run routes:generate && tsc --noEmit",
		"test": "bun test src/lib/chat.test.ts",
		"preview": "vite preview"
	},
	"dependencies": {
		"@hyperquote/ai": "workspace:*",
		"@hyperquote/auth": "workspace:*",
		"@hyperquote/docs": "workspace:*",
		"@hyperquote/forms": "workspace:*",
		"@hyperquote/i18n": "workspace:*",
		"@hyperquote/quote-cart": "workspace:*",
		"@hyperquote/runtime": "workspace:*",
		"@hyperquote/types": "workspace:*",
		"@hyperquote/ui": "workspace:*",
		"@tanstack/ai": "^0.9.2",
		"@tanstack/ai-react": "0.7.8",
		"@tanstack/react-router": "^1.170.8",
		"@tanstack/react-start": "^1.168.13",
		"fuse.js": "^7.1.0",
		"i18next": "^26.2.0",
		"lucide-react": "^1.16.0",
		"marked": "^17.0.6",
		"motion": "^12.38.0",
		"react": "^19.2.6",
		"react-aria-components": "^1.17.0",
		"react-dom": "^19.2.6",
		"react-hook-form": "^7.76.0",
		"react-i18next": "^17.0.8",
		"zod": "^4.4.3",
		"zustand": "^5.0.13"
	},
	"devDependencies": {
		"@tanstack/router-cli": "1.167.10",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"tailwindcss": "^4.3.0",
		"tailwindcss-react-aria-components": "^2.1.0",
		"typescript": "^6.0.3",
		"vite": "~7.3.5"
	}
}
