# apps/website — public marketing + product catalog
# Prefer Infisical dev at /Projects/HyperQuote; ignored .env is a local fallback.

# ─── Supabase server (Worker secrets in production) ───────────
# Local Supabase values come from db:start; production syncs Infisical prod to Workers.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth session cookie scope ─────────────────────────────
# Production website + portal should share this customer cookie on hyperquote.net.
SUPABASE_COOKIE_NAME=hyperquote_customer_auth
# Leave unset for localhost; configure this domain only in production.
# COOKIE_DOMAIN=.hyperquote.net

# ─── Public support channels ───────────────────────────────
# VITE_SUPPORT_PHONE_E164=+20xxxxxxxxxx
# VITE_SUPPORT_PHONE_LABEL=+20 xxx xxx xxxx
# VITE_SUPPORT_WHATSAPP_E164=+20xxxxxxxxxx

# ─── AI chat (server only; do not prefix with VITE_) ────────
# Local dev: inject GROQ_API_KEY from Infisical dev at /Projects/HyperQuote.
# Production: sync this from Infisical prod into Worker secrets.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
USE_AI=1
# For Qwen only:
# GROQ_REASONING_EFFORT=none
# GROQ_URL=https://api.groq.com/openai/v1/chat/completions
