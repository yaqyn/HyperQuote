# apps/website — public marketing + product catalog
# Copy to `.env` and fill in. `.env` is gitignored.

# ─── Supabase (anonymous catalog reads) ────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Cross-app URLs ────────────────────────────────────────
VITE_PORTAL_URL=https://portal.hyperquote.net
VITE_INTERNAL_URL=https://ops.hyperquote.net

# ─── Maps (MapTiler — Arabic labels + tiles) ───────────────
VITE_MAPTILER_KEY=your-maptiler-key

# ─── AI chat (server only; do not prefix with VITE_) ────────
# Local dev: set GROQ_API_KEY in .env or run the dev server through Infisical.
# Production: set this as a Worker secret / Infisical runtime secret.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
# For Qwen only:
# GROQ_REASONING_EFFORT=none
# GROQ_URL=https://api.groq.com/openai/v1/chat/completions
# USE_AI=1
