# apps/driver — Capacitor SPA (NOT TanStack Start)
# Server functions don't work in Capacitor WebViews — all env is VITE_-prefixed.
# Copy to `.env` and fill in. `.env` is gitignored.

# ─── Supabase (browser) ────────────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── PowerSync — offline-first sync for unreliable networks ──
VITE_POWERSYNC_URL=https://your-instance.powersync.journeyapps.com

# ─── Maps — online tiles + PMTiles offline fallback ────────
VITE_MAPTILER_KEY=your-maptiler-key

# ─── Web Push (VAPID public key) ───────────────────────────
# For delivery assignment + route update notifications.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ─── Capacitor Background Geolocation ──────────────────────
# License key from https://dashboard.transistorsoft.com
# (Starter license — ~$399 one-time)
CAPACITOR_TS_BG_GEO_LICENSE_KEY=your-transistor-license-key
