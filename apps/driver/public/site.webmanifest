{
	"id": "/",
	"name": "HyperQuote Driver",
	"short_name": "HQ Driver",
	"description": "Private HyperQuote driver app for assigned routes, delivery status, location updates, and proof of delivery.",
	"start_url": "/",
	"scope": "/",
	"display": "standalone",
	"display_override": ["standalone", "minimal-ui"],
	"background_color": "#ffffff",
