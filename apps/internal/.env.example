# apps/internal — ops console (sales, procurement, warehouse, finance, dispatch, CS, admin)
# Copy to `.env` and fill in. `.env` is gitignored.

# ─── Supabase client (browser) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Supabase server (Cloudflare Worker secrets) ───────────
# Set via `wrangler secret put <name>` in production.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth session cookie scope ─────────────────────────────
COOKIE_DOMAIN=.hyperquote.net

# ─── Maps — dispatch route rendering ───────────────────────
VITE_MAPTILER_KEY=your-maptiler-key

# ─── Web Push (VAPID public key) ───────────────────────────
# For in-app notifications (SLA breach, new quote, payment received, etc.)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ─── Cloudflare bindings — NOT .env ────────────────────────
# Workers AI, AI Gateway, KV, R2, D1, Queues are bound in `wrangler.jsonc`.
# Don't duplicate them here.
