# apps/internal — ops console (sales, procurement, warehouse, finance, dispatch, CS, admin)
# Prefer Infisical dev at /Projects/HyperQuote; ignored .env is a local fallback.

# ─── Supabase client (browser) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Supabase server (Worker secrets in production) ───────────
# Local Supabase values come from db:start; production syncs Infisical prod to Workers.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth session cookie scope ─────────────────────────────
# Keep internal auth host-scoped and separate from the customer cookie.
SUPABASE_COOKIE_NAME=hyperquote_internal_auth

# ─── Maps — dispatch route rendering ───────────────────────
VITE_MAPTILER_KEY=your-maptiler-key
# Optional. Defaults to the public OSRM route endpoint when unset.
VITE_ROAD_ROUTE_ENDPOINT=https://router.project-osrm.org/route/v1/driving

# ─── AI chat (server only; do not prefix with VITE_) ────────
# Local dev: inject GROQ_API_KEY from Infisical dev at /Projects/HyperQuote.
# Production: sync this from Infisical prod into Worker secrets.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
USE_AI=1
# For Qwen only:
# GROQ_REASONING_EFFORT=none
# GROQ_URL=https://api.groq.com/openai/v1/chat/completions

# ─── Customer service email (server only; Worker secrets in production)
# Inject from Infisical dev locally; sync Infisical prod into Worker secrets.
RESEND_API_KEY=your-resend-api-key
# Optional sender/link overrides:
# SUPPORT_EMAIL_FROM=HyperQuote <support@hyperquote.net>
# SUPPORT_REPLY_TO=support@hyperquote.net
# WEBSITE_URL=https://www.hyperquote.net
# PORTAL_URL=https://portal.hyperquote.net
# SUPPORT_URL=https://www.hyperquote.net/support#contact
# SUPPORT_PHONE_E164=+20xxxxxxxxxx
# SUPPORT_WHATSAPP_E164=+20xxxxxxxxxx
# OFFICE_ADDRESS=your-office-address
# OFFICE_MAP_URL=https://maps.google.com/?q=your-office-address

# ─── Cloudflare bindings — NOT .env ────────────────────────
# Existing bindings are defined in each app's `wrangler.jsonc`.
# Do not add new platform resources without an architecture decision.
# Don't duplicate them here.
