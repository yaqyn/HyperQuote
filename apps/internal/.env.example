# apps/internal — ops console (sales, procurement, warehouse, finance, dispatch, CS, admin)
# Copy to `.env` and fill in. `.env` is gitignored.

# ─── Supabase client (browser) ─────────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ─── Supabase server (Cloudflare Worker secrets) ───────────
# Set via `wrangler secret put <name>` in production.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Auth session cookie scope ─────────────────────────────
COOKIE_DOMAIN=.hyperquote.net

# ─── Maps — dispatch route rendering ───────────────────────
VITE_MAPTILER_KEY=your-maptiler-key

# ─── Web Push (VAPID public key) ───────────────────────────
# For in-app notifications (SLA breach, new quote, payment received, etc.)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# ─── AI chat (server only; do not prefix with VITE_) ────────
# Local dev: set GROQ_API_KEY in .env or run the dev server through Infisical.
# Production: set this as a Worker secret / Infisical runtime secret.
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-120b
# For Qwen only:
# GROQ_REASONING_EFFORT=none
# GROQ_URL=https://api.groq.com/openai/v1/chat/completions
# USE_AI=1

# ─── Cloudflare bindings — NOT .env ────────────────────────
# Workers AI, AI Gateway, KV, R2, D1, Queues are bound in `wrangler.jsonc`.
# Don't duplicate them here.
