{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "hyperquote-internal",
	"main": "./src/server.ts",
	"compatibility_date": "2026-05-22",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"routes": [
		{
			"pattern": "internal.hyperquote.net",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"APP_ENV": "production",
		"DRIVER_URL": "https://driver.hyperquote.net",
		"INTERNAL_URL": "https://internal.hyperquote.net",
		"PORTAL_URL": "https://portal.hyperquote.net",
		"SUPABASE_COOKIE_NAME": "hyperquote_internal_auth",
		"WEBSITE_URL": "https://www.hyperquote.net"
	}
}
