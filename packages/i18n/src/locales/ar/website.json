  "about": {
    "heroHeadline": "\u0646\u0628\u0646\u064a \u0645\u0633\u062a\u0642\u0628\u0644 \u0645\u0635\u0631 \u0645\u0639\u064b\u0627",
    "story": {
      "heading": "\u0642\u0635\u062a\u0646\u0627",
      "p1": "\u0648\u064f\u0644\u062f\u062a \u0647\u0627\u064a\u0628\u0631\u0643\u0648\u062a \u0645\u0646 \u0645\u0644\u0627\u062d\u0638\u0629 \u0628\u0633\u064a\u0637\u0629: \u062a\u0648\u0631\u064a\u062f \u0645\u0648\u0627\u062f \u0627\u0644\u0628\u0646\u0627\u0621 \u0641\u064a \u0645\u0635\u0631 \u0645\u0627 \u064a\u0646\u0628\u063a\u064a\u0634 \u064a\u0643\u0648\u0646 \u0628\u0647\u0630\u0647 \u0627\u0644\u0635\u0639\u0648\u0628\u0629. \u0627\u0644\u0645\u0642\u0627\u0648\u0644\u0648\u0646 \u0628\u064a\u0642\u0636\u0648\u0627 \u0623\u064a\u0627\u0645 \u0641\u064a \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u0645\u0648\u0631\u0651\u062f\u064a\u0646 \u0648\u0645\u0642\u0627\u0631\u0646\u0629 \u0627\u0644\u0623\u0633\u0639\u0627\u0631 \u0648\u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u062a\u0648\u0635\u064a\u0644\u0627\u062a \u2014 \u0648\u0642\u062a \u0627\u0644\u0645\u0641\u0631\u0648\u0636 \u064a\u062a\u0635\u0631\u0641 \u0641\u064a \u0627\u0644\u0628\u0646\u0627\u0621.",
      "p2": "\u062a\u0623\u0633\u0633\u0646\u0627 \u0641\u064a \u0627\u0644\u0642\u0627\u0647\u0631\u0629 \u0628\u0647\u062f\u0641 \u0631\u0642\u0645\u0646\u0629 \u0633\u0644\u0633\u0644\u0629 \u062a\u0648\u0631\u064a\u062f \u0645\u0648\u0627\u062f \u0627\u0644\u0628\u0646\u0627\u0621 \u0628\u0627\u0644\u0643\u0627\u0645\u0644. \u0645\u0646\u0635\u062a\u0646\u0627 \u062a\u0631\u0628\u0637 \u0627\u0644\u0645\u0642\u0627\u0648\u0644\u064a\u0646 \u0628\u0645\u0648\u0631\u0651\u062f\u064a\u0646 \u0645\u0639\u062a\u0645\u062f\u064a\u0646\u060c \u0648\u062a\u0624\u062a\u0645\u062a \u0639\u0645\u0644\u064a\u0629 \u0627\u0644\u062a\u0633\u0639\u064a\u0631\u060c \u0648\u062a\u0648\u0641\u0651\u0631 \u062a\u062a\u0628\u0639 \u0641\u0648\u0631\u064a \u0644\u0644\u062a\u0648\u0635\u064a\u0644\u0627\u062a.",
      "p3": "\u0627\u0644\u0646\u0647\u0627\u0631\u062f\u0629\u060c \u0628\u0646\u062e\u062f\u0645 \u0645\u0626\u0627\u062a \u0627\u0644\u0645\u0642\u0627\u0648\u0644\u064a\u0646 \u0641\u064a \u0645\u0635\u0631\u060c \u0648\u0628\u0646\u0639\u0627\u0644\u062c \u0622\u0644\u0627\u0641 \u0627\u0644\u0639\u0631\u0648\u0636 \u0648\u0627\u0644\u062a\u0648\u0635\u064a\u0644\u0627\u062a. \u0628\u0633 \u0625\u062d\u0646\u0627 \u0644\u0633\u0647 \u0641\u064a \u0627\u0644\u0628\u062f\u0627\u064a\u0629."
    },
