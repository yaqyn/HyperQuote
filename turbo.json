{
	"$schema": "https://turborepo.dev/schema.json",
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/packages/*/package.json",
				"$TURBO_ROOT$/packages/*/src/**",
				"$TURBO_ROOT$/packages/*/tsconfig.json",
				"$TURBO_ROOT$/tooling/vite/**"
			],
			"outputs": [".output/**", "dist/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"lint": {},
		"typecheck": {
			"dependsOn": ["^build"],
			"inputs": [
				"$TURBO_DEFAULT$",
				"$TURBO_ROOT$/packages/*/package.json",
				"$TURBO_ROOT$/packages/*/src/**",
				"$TURBO_ROOT$/packages/*/tsconfig.json"
			]
		}
	}
}
