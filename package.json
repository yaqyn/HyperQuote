{
	"name": "hyperquote",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"typecheck": "turbo typecheck",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"knip": "knip",
		"sync": "syncpack lint",
		"sync:fix": "syncpack fix-mismatches",
		"leaks": "gitleaks git --verbose --redact --no-banner",
		"secrets": "infisical secrets --env=prod --recursive -o json | jq -r '.[].secretKey' | sort",
		"deploy:website": "infisical run --env=prod --recursive -- bun --cwd apps/website run deploy",
		"deploy:portal": "infisical run --env=prod --recursive -- bun --cwd apps/portal run deploy",
		"deploy:internal": "infisical run --env=prod --recursive -- bun --cwd apps/internal run deploy",
		"deploy:ceo": "infisical run --env=prod --recursive -- bunx wrangler deploy --config apps/ceo/wrangler.jsonc",
		"db:types": "supabase gen types typescript --project-id \"$SUPABASE_PROJECT_REF\" > packages/types/src/supabase.ts",
		"db:diff": "supabase db diff",
		"db:push": "infisical run --env=prod --path=/master -- supabase db push"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@types/node": "^25.6.0",
		"knip": "^6.4.1",
		"lefthook": "^2.1.6",
		"syncpack": "^14.3.0",
		"turbo": "^2.8.21",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.11",
	"dependencies": {}
}
