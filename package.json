{
	"name": "hyperquote",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "bun scripts/dev-tui.mjs",
		"dev:doctor": "node scripts/dev-smart.mjs --doctor --no-update",
		"dev:plain": "node scripts/dev-smart.mjs",
		"dev:tui:test": "bun test scripts/dev-tui.test.mjs",
		"dev:tools:update": "node scripts/update-dev-tools.mjs --force",
		"build": "turbo build",
		"build:workers": "bunx turbo run build:worker --force",
		"test": "turbo test",
		"configure:supabase:production": "node scripts/configure-supabase-production.mjs",
		"deploy:cloudflare-rules:production": "node scripts/configure-cloudflare-production.mjs",
		"deploy:supabase:production": "node scripts/deploy-supabase-production.mjs",
		"deploy:worker-secrets": "node scripts/sync-worker-secrets.mjs all",
		"lint": "turbo lint",
		"typecheck": "turbo typecheck",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"check:ci": "biome check .",
		"pwa:generate": "node scripts/generate-pwa-assets.mjs && node scripts/generate-service-workers.mjs",
		"pwa:check": "node scripts/check-pwa-assets.mjs",
		"knip": "knip",
		"knip:deps": "knip --dependencies",
		"knip:exports": "knip --exports",
		"sync": "syncpack lint",
		"sync:fix": "syncpack fix",
		"dev:local": "node scripts/dev-local.mjs",
		"dev:raw": "node scripts/dev-local.mjs",
		"db:start": "node scripts/supabase-local.mjs start",
		"db:stop": "node scripts/supabase-local.mjs stop",
		"db:reset": "node scripts/supabase-local.mjs db reset && node scripts/harden-local-supabase-api-boundary.mjs && node scripts/seed-local-auth.mjs --quiet",
		"db:migrate": "node scripts/supabase-local.mjs migration up",
		"db:api-boundary": "node scripts/assert-supabase-api-boundary.mjs",
		"db:seed:local-auth": "node scripts/seed-local-auth.mjs",
		"db:seed:showcase": "node scripts/seed-showcase-baseline.mjs",
		"db:verify:showcase": "node scripts/verify-showcase-baseline.mjs",
		"db:reset:production:showcase": "node scripts/reset-supabase-production-showcase.mjs",
		"db:types": "node scripts/db-types-local.mjs",
		"flow:db-smoke": "node scripts/flow-db-smoke.mjs",
		"flow:evidence": "node scripts/flow-evidence.mjs --write",
		"flow:tasklist": "node scripts/flow-human-tasklist.mjs --write",
		"flow:tasklist:check": "node scripts/flow-human-tasklist.mjs --check",
		"flow:browser-smoke": "env -u NO_COLOR playwright test scripts/flow-browser-smoke.spec.ts --reporter=line --workers=1",
		"leaks": "gitleaks git --verbose --redact --no-banner",
		"scan:arch": "depcruise --config .dependency-cruiser.cjs --include-only \"^(apps|packages)/\" --exclude \"node_modules|dist|\\.output|\\.turbo|routeTree\\.gen\\.ts|apps/driver/(android/app/src/main/assets/public|ios/App/App/public)\" apps packages --output-type err",
		"scan:duplicates": "jscpd apps packages --config .jscpd.json --gitignore --noSymlinks --noTips",
		"scan:secrets": "gitleaks git --verbose --redact --no-banner",
		"scan:vulns": "osv-scanner scan source -r .",
		"scan:semgrep": "semgrep validate .semgrep.yml && semgrep scan --config .semgrep.yml --error --metrics=off --disable-version-check apps packages",
		"secrets:check": "bun run secrets:check:dev",
		"secrets:check:dev": "node scripts/verify-infisical-env.mjs dev",
		"secrets:check:production": "node scripts/verify-infisical-env.mjs production",
		"secrets:check:prod": "node scripts/verify-infisical-env.mjs production",
		"smoke:production": "node scripts/smoke-production.mjs"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@cloudflare/vite-plugin": "^1.37.1",
		"@opentui/core": "0.4.3",
		"@playwright/test": "^1.60.0",
		"@supabase/ssr": "^0.9.0",
		"@supabase/supabase-js": "^2.106.1",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/react-start": "^1.168.13",
		"@types/node": "^25.9.1",
		"@vitejs/plugin-react": "~5.2.0",
		"dependency-cruiser": "17.4.0",
		"jscpd": "^4.2.3",
		"knip": "^6.14.2",
		"lefthook": "^2.1.8",
		"nitro": "^3.0.260522-beta",
		"syncpack": "^15.3.1",
		"turbo": "^2.9.14",
		"typescript": "^6.0.3",
		"wrangler": "^4.92.0"
	},
	"packageManager": "bun@1.3.11",
	"dependencies": {},
	"overrides": {
		"@babel/core": "7.29.6",
		"@babel/plugin-transform-modules-systemjs": "7.29.4",
		"@xmldom/xmldom": "0.8.13",
		"brace-expansion": "5.0.6",
		"esbuild": "0.28.1",
		"fast-uri": "3.1.2",
		"js-yaml": "4.2.0",
		"postcss": "8.5.10",
		"protocol-buffers-schema": "3.6.1",
		"tar": "7.5.16",
		"undici": "7.28.0",
		"vite": "~7.3.5",
		"ws": "8.21.0"
	}
}
