{
	"name": "hyperquote",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev": "turbo dev",
		"build": "turbo build",
		"lint": "turbo lint",
		"typecheck": "turbo typecheck",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"check:ci": "biome check .",
		"knip": "knip",
		"knip:deps": "knip --dependencies",
		"knip:exports": "knip --exports",
		"sync": "syncpack lint",
		"sync:fix": "syncpack fix",
		"leaks": "gitleaks git --verbose --redact --no-banner",
		"scan:arch": "depcruise --no-config --include-only \"^(apps|packages)/\" --exclude \"node_modules|dist|\\.output|\\.turbo|routeTree\\.gen\\.ts\" apps packages --output-type err",
		"scan:duplicates": "jscpd apps packages --ignore \"**/node_modules/**,**/dist/**,**/.output/**,**/.turbo/**,**/routeTree.gen.ts,apps/driver/android/app/src/main/assets/public/**,apps/driver/ios/App/App/public/**\" --min-lines 8 --min-tokens 80",
		"scan:secrets": "gitleaks git --verbose --redact --no-banner",
		"scan:vulns": "osv-scanner scan source -r .",
		"scan:semgrep": "semgrep scan --config auto .",
		"secrets": "infisical secrets --env=prod --recursive -o json | jq -r '.[].secretKey' | sort",
		"deploy:website": "infisical run --env=prod --recursive -- bun run --cwd apps/website deploy",
		"deploy:portal": "infisical run --env=prod --recursive -- bun run --cwd apps/portal deploy",
		"deploy:internal": "infisical run --env=prod --recursive -- bun run --cwd apps/internal deploy",
		"deploy:driver": "infisical run --env=prod --recursive -- bun run --cwd apps/driver deploy"
	},
	"devDependencies": {
		"@ast-grep/cli": "0.42.2",
		"@biomejs/biome": "^2.4.15",
		"@types/node": "^25.8.0",
		"dependency-cruiser": "17.4.0",
		"jscpd": "^4.2.3",
		"knip": "^6.14.1",
		"lefthook": "^2.1.6",
		"rollup-plugin-visualizer": "7.0.1",
		"syncpack": "^15.2.0",
		"turbo": "^2.9.14",
		"typescript": "^6.0.3"
	},
	"packageManager": "bun@1.3.11",
	"dependencies": {},
	"overrides": {
		"@babel/plugin-transform-modules-systemjs": "7.29.4",
		"@xmldom/xmldom": "0.8.13",
		"fast-uri": "3.1.2",
		"postcss": "8.5.10",
		"protocol-buffers-schema": "3.6.1",
		"vite": "~7.3.3"
	}
}
